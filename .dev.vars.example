# Lokal dev saja (jangan set DEV_BYPASS_ACCESS di Cloudflare Workers produksi)
DEV_BYPASS_ACCESS=true

# Secret utama untuk tanda tangan cookie sesi & setup akun admin pertama (minimal 24 karakter acak)
# Di produksi, pasang lewat: npx wrangler secret put ADMIN_SESSION_SECRET
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-minimal-24-karakter

# Domain publik R2
R2_PUBLIC_BASE_URL=https://media.anselmoments.com
